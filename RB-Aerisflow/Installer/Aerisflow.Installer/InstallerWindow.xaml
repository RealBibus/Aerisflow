<Window x:Class="Aerisflow.Installer.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aerisflow Setup"
        Width="480"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#12FFFFFF"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="PressBrush" Color="#0FFFFFFF"/>
        <SolidColorBrush x:Key="HeaderBrush" Color="#66FFFFFF"/>
        <SolidColorBrush x:Key="ValueBrush" Color="#99FFFFFF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F2FFFFFF"/>

        <Style x:Key="GroupHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,0,0,10"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SectionSeparator" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="OptionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="OptionHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ValueBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="SwitchToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track" CornerRadius="10" Background="#33FFFFFF"/>
                            <Border x:Name="TrackOn" CornerRadius="10" Opacity="0"
                                    Background="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/>
                            <Ellipse x:Name="Knob" Width="12" Height="12" Fill="#FFB9B9BE"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="KnobShift" X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                             Storyboard.TargetProperty="X" To="20"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="TrackOn"
                                                             Storyboard.TargetProperty="Opacity" To="1"
                                                             Duration="0:0:0.18"/>
                                            <ColorAnimation Storyboard.TargetName="Knob"
                                                            Storyboard.TargetProperty="(Ellipse.Fill).(SolidColorBrush.Color)"
                                                            To="#FFFFFFFF" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                             Storyboard.TargetProperty="X" To="0"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="TrackOn"
                                                             Storyboard.TargetProperty="Opacity" To="0"
                                                             Duration="0:0:0.18"/>
                                            <ColorAnimation Storyboard.TargetName="Knob"
                                                            Storyboard.TargetProperty="(Ellipse.Fill).(SolidColorBrush.Color)"
                                                            To="#FFB9B9BE" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="#E6FFFFFF"/>
            <Setter Property="Background" Value="#00FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TinyButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="#99FFFFFF"/>
        </Style>

        <Style x:Key="CloseGlyphButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#99FFFFFF"/>
            <Setter Property="Content" Value="&#xE711;"/>
        </Style>

        <Style x:Key="SetupProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="5"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="#26FFFFFF" CornerRadius="2.5"/>
                            <Border x:Name="PART_Indicator" Background="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"
                                    CornerRadius="2.5" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Border x:Name="RootBorder"
                Background="#38141418"
                BorderBrush="#2AFFFFFF"
                BorderThickness="1"
                CornerRadius="16"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5">
            <Border.Effect>
                <DropShadowEffect BlurRadius="38" ShadowDepth="0" Opacity="0.55" Color="#FF000000"/>
            </Border.Effect>
            <Border.RenderTransform>
                <ScaleTransform x:Name="RootScale" ScaleX="0.97" ScaleY="0.97"/>
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="22,20,18,18">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="50" Height="50" CornerRadius="13" Background="#1FFFFFFF"
                                HorizontalAlignment="Center">
                            <Image Source="Aerisflow.ico" Width="40" Height="40"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <TextBlock Text="Aerisflow" Foreground="{StaticResource TextBrush}"
                                   FontSize="22" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        <TextBlock Text="Snow on your desktop" Foreground="{StaticResource ValueBrush}"
                                   FontSize="11.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Border x:Name="VersionBadge" Background="#14FFFFFF" CornerRadius="10"
                                Padding="9,4" Margin="0,0,6,0" VerticalAlignment="Center">
                            <TextBlock x:Name="VersionText" Text=""
                                       Foreground="{StaticResource ValueBrush}" FontSize="10.5"/>
                        </Border>
                        <Button x:Name="HeaderCloseButton" Style="{StaticResource CloseGlyphButton}" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Margin="22,0,22,0">
                    <TextBlock Text="INSTALL" Style="{StaticResource GroupHeader}"/>
                    <Grid Margin="2,0,2,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Install location" Style="{StaticResource OptionLabel}"/>
                            <TextBlock x:Name="InstallPathText" Text="%LocalAppData%\Aerisflow"
                                       Foreground="{StaticResource ValueBrush}" FontSize="11"
                                       TextTrimming="CharacterEllipsis" Margin="0,3,8,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="StateText" Text="Not installed"
                                       Foreground="{StaticResource ValueBrush}" FontSize="11"
                                       HorizontalAlignment="Right"/>
                            <TextBlock x:Name="StateHint" Text="Per-user install · no admin needed"
                                       Foreground="#66FFFFFF" FontSize="10" Margin="0,2,0,0"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SectionSeparator}"/>
                    <TextBlock Text="OPTIONS" Style="{StaticResource GroupHeader}"/>
                    <StackPanel Margin="2,0,2,14">
                        <Grid Margin="0,0,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Start with Windows" Style="{StaticResource OptionLabel}"/>
                            <ToggleButton Grid.Column="1" x:Name="AutoStartToggle"
                                          Style="{StaticResource SwitchToggle}" IsChecked="True"/>
                        </Grid>
                        <Grid Margin="0,5,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Desktop shortcut" Style="{StaticResource OptionLabel}"/>
                            <ToggleButton Grid.Column="1" x:Name="DesktopToggle"
                                          Style="{StaticResource SwitchToggle}" IsChecked="True"/>
                        </Grid>
                        <Grid Margin="0,5,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Start menu shortcut" Style="{StaticResource OptionLabel}"/>
                            <ToggleButton Grid.Column="1" x:Name="StartMenuToggle"
                                          Style="{StaticResource SwitchToggle}" IsChecked="True"/>
                        </Grid>
                        <Grid Margin="0,5,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Launch when finished" Style="{StaticResource OptionLabel}"/>
                            <ToggleButton Grid.Column="1" x:Name="LaunchToggle"
                                          Style="{StaticResource SwitchToggle}" IsChecked="True"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="NotesSection">
                        <Border Style="{StaticResource SectionSeparator}"/>
                        <Grid Margin="2,0,2,8">
                            <TextBlock Text="WHAT'S NEW" Style="{StaticResource GroupHeader}"
                                       HorizontalAlignment="Left" Margin="2,0,0,0"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock x:Name="NotesStatus" Text="Loading…"
                                           Foreground="#66FFFFFF" FontSize="10"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button x:Name="NotesRetryButton" Style="{StaticResource TinyButton}"
                                        Content="Retry" Visibility="Collapsed" Margin="0,0,4,0"
                                        Click="NotesRetryButton_Click"/>
                                <Button x:Name="NotesOpenButton" Style="{StaticResource TinyButton}"
                                        Content="GitHub" Click="NotesOpenButton_Click"/>
                            </StackPanel>
                        </Grid>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="8"
                                Padding="10,8" Margin="2,0,2,14" MaxHeight="160">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="NotesText" Foreground="#CCFFFFFF" FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Text="Fetching release notes from GitHub…"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>

                    <Border Style="{StaticResource SectionSeparator}"/>
                    <TextBlock Text="PROGRESS" Style="{StaticResource GroupHeader}"/>
                    <StackPanel Margin="2,0,2,14">
                        <Grid Margin="0,0,0,8">
                            <TextBlock x:Name="StatusText" Text="Ready to install."
                                       Foreground="#CCFFFFFF" FontSize="11.5"
                                       TextWrapping="Wrap" Margin="0,0,10,0"/>
                            <TextBlock x:Name="PercentText" Text=""
                                       Foreground="{StaticResource ValueBrush}" FontSize="11"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <ProgressBar x:Name="InstallProgress" Style="{StaticResource SetupProgress}" Value="0"/>
                    </StackPanel>

                    <TextBlock x:Name="FootnoteText"
                               Text="Your snow settings are kept when you install again."
                               Foreground="#66FFFFFF" FontSize="10.5" Margin="2,0,0,0"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>

                <Grid Grid.Row="2" Margin="22,16,22,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FooterHint" Text="Installs for the current user only."
                               Foreground="#66FFFFFF" FontSize="10.5" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="UninstallButton" Style="{StaticResource GhostButton}"
                                Content="Uninstall" Margin="0,0,6,0" Visibility="Collapsed"
                                Click="UninstallButton_Click"/>
                        <Button x:Name="CloseButton" Style="{StaticResource GhostButton}"
                                Content="Cancel" Margin="0,0,6,0" Click="CloseButton_Click"/>
                        <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}"
                                Content="Install" Click="InstallButton_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>