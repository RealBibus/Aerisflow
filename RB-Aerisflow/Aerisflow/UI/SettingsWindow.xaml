<Window x:Class="Aerisflow.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aerisflow Settings" Height="400" Width="450"
        WindowStartupLocation="CenterScreen"
        Background="#1C1C1C" Foreground="White"
        WindowStyle="ToolWindow">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Настройки симуляции" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>
            
            <!-- НАСТРОЙКА FPS -->
            <TextBlock Text="Ограничение FPS (0 = без лимита):" Margin="0,0,0,5"/>
            <Slider x:Name="FpsSlider" Minimum="15" Maximum="144" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,5" ValueChanged="FpsSlider_ValueChanged"/>
            <TextBlock x:Name="FpsText" Text="60 FPS" Margin="0,0,0,20" HorizontalAlignment="Right" Foreground="Gray"/>

            <TextBlock Text="Базовая интенсивность снега:" Margin="0,0,0,5"/>
            <Slider x:Name="IntensitySlider" Minimum="0.1" Maximum="2.0" ValueChanged="IntensitySlider_ValueChanged" Margin="0,0,0,20"/>

            <TextBlock Text="Прозрачность:" Margin="0,0,0,5"/>
            <Slider x:Name="OpacitySlider" Minimum="0.15" Maximum="1.0" ValueChanged="OpacitySlider_ValueChanged" Margin="0,0,0,20"/>

            <Button Content="Закрыть" Click="CloseButton_Click" HorizontalAlignment="Right" Padding="20,5"/>
        </StackPanel>
    </Grid>
</Window>