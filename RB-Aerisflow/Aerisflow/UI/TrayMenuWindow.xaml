<Window x:Class="Aerisflow.UI.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aerisflow"
        Width="310"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Deactivated="Window_Deactivated"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="MenuHoverBrush" Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="MenuPressBrush" Color="#0FFFFFFF"/>
        <SolidColorBrush x:Key="MenuIdleBrush"  Color="#00FFFFFF"/>
        <SolidColorBrush x:Key="CardBrush" Color="#12FFFFFF"/>
        <SolidColorBrush x:Key="HeaderBrush" Color="#66FFFFFF"/>

        <Style x:Key="SliderFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" VerticalAlignment="Center" CornerRadius="2"
                                Background="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderEmpty" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" VerticalAlignment="Center" CornerRadius="2" Background="#33FFFFFF"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderThumb" TargetType="Thumb">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Width="14" Height="14" CornerRadius="7"
                                Background="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"
                                BorderBrush="#FF000000" BorderThickness="1.5"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuSlider" TargetType="Slider">
            <Setter Property="Height" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Background="Transparent">
                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                    Background="#33FFFFFF" SnapsToDevicePixels="True"/>
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderFill}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderEmpty}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwitchToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track" CornerRadius="10" Background="#33FFFFFF"/>
                            <Border x:Name="TrackOn" CornerRadius="10" Opacity="0"
                                    Background="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/>
                            <Ellipse x:Name="Knob" Width="12" Height="12" Fill="#FFB9B9BE"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="KnobShift" X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"
                                                             To="20" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.18"/>
                                            <ColorAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(Ellipse.Fill).(SolidColorBrush.Color)"
                                                            To="#FFFFFFFF" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.18"/>
                                            <ColorAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(Ellipse.Fill).(SolidColorBrush.Color)"
                                                            To="#FFB9B9BE" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource MenuIdleBrush}"/>
            <Setter Property="Foreground" Value="#F2FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource MenuHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource MenuPressBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E6FFFFFF"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SubItemLabel" TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}">
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
        </Style>
        <Style x:Key="SectionValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#99FFFFFF"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="GroupHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,0,0,4"/>
        </Style>

        <Style x:Key="PopPanel" TargetType="Border">
            <Setter Property="RenderTransformOrigin" Value="0.5,0"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                        <TranslateTransform Y="10"/>
                    </TransformGroup>
                </Setter.Value>
            </Setter>
            <Setter Property="Opacity" Value="0"/>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                             To="1" Duration="0:0:0.22">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                             To="1" Duration="0:0:0.22">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                             To="0" Duration="0:0:0.22">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            CornerRadius="12"
            Background="#38141418"
            BorderBrush="#2AFFFFFF"
            BorderThickness="1"
            Padding="12,10,12,10">
        <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="SNOW" Style="{StaticResource GroupHeader}"/>
                <Border Style="{StaticResource PopPanel}" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="10,6" Margin="0,0,0,7">
                    <StackPanel>
                        <Grid Margin="0,0,0,3">
                            <TextBlock Text="Intensity" Style="{StaticResource SectionLabel}"/>
                            <TextBlock x:Name="IntensityValue" Text="100%" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"
                                       FontSize="11.5" FontWeight="SemiBold"/>
                        </Grid>
                        <Slider x:Name="IntensitySlider" Style="{StaticResource MenuSlider}"
                                Minimum="0.1" Maximum="4.0" SmallChange="0.1" LargeChange="0.5" Margin="0,0,0,2"/>
                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Light" FontSize="9" Foreground="#66FFFFFF" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Column="1" Text="Normal" FontSize="9" Foreground="#66FFFFFF" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Heavy" FontSize="9" Foreground="#66FFFFFF" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="Whiteout" FontSize="9" Foreground="#66FFFFFF" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,3">
                            <TextBlock Text="Snow speed" Style="{StaticResource SectionLabel}"/>
                            <TextBlock x:Name="SpeedValue" Text="1.0x" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"
                                       FontSize="11.5" FontWeight="SemiBold"/>
                        </Grid>
                        <Slider x:Name="SpeedSlider" Style="{StaticResource MenuSlider}"
                                Minimum="0.4" Maximum="2.5" SmallChange="0.1" LargeChange="0.5" Margin="0,0,0,7"/>

                        <Border x:Name="PrecipHit" Background="Transparent" MouseLeftButtonUp="PrecipHit_MouseUp" Cursor="Hand">
                            <Grid Height="22">
                                <TextBlock Text="Precipitation" Style="{StaticResource SubItemLabel}"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock x:Name="PrecipValue" Text="Snow" Style="{StaticResource SectionValue}"/>
                                    <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               Margin="6,1,0,0" Foreground="#99FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Margin="0,5,0,3">
                            <TextBlock Text="Wind swing" Style="{StaticResource SectionLabel}"/>
                            <TextBlock x:Name="WindSwingValue" Text="35%" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"
                                       FontSize="11.5" FontWeight="SemiBold"/>
                        </Grid>
                        <Slider x:Name="WindSwingSlider" Style="{StaticResource MenuSlider}"
                                Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.2" Margin="0,0,0,7"/>

                        <Grid Margin="0,0,0,3">
                            <TextBlock Text="Bass kick" Style="{StaticResource SectionLabel}"/>
                            <TextBlock x:Name="BassValue" Text="60%" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"
                                       FontSize="11.5" FontWeight="SemiBold"/>
                        </Grid>
                        <Slider x:Name="BassSlider" Style="{StaticResource MenuSlider}"
                                Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.2" Margin="0,0,0,7"/>

                        <Border x:Name="OpacityHit" Background="Transparent" MouseLeftButtonUp="OpacityHit_MouseUp" Cursor="Hand">
                            <Grid Height="22">
                                <TextBlock Text="Opacity" Style="{StaticResource SubItemLabel}"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock x:Name="OpacityValue" Text="100%" Style="{StaticResource SectionValue}"/>
                                    <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               Margin="6,1,0,0" Foreground="#99FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Slider x:Name="OpacitySlider" Style="{StaticResource MenuSlider}"
                                Minimum="0.15" Maximum="1" SmallChange="0.05" LargeChange="0.2"
                                Margin="12,2,0,5" Visibility="Collapsed"/>

                        <Border x:Name="ModeHit" Background="Transparent" MouseLeftButtonUp="ModeHit_MouseUp" Cursor="Hand">
                            <Grid Height="22">
                                <TextBlock Text="Mode" Style="{StaticResource SubItemLabel}"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock x:Name="ModeValue" Text="Auto" Style="{StaticResource SectionValue}"/>
                                    <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               Margin="6,1,0,0" Foreground="#99FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock Text="BEHAVIOR" Style="{StaticResource GroupHeader}"/>
                <Border Style="{StaticResource PopPanel}" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="10,6" Margin="0,0,0,7">
                    <StackPanel>
                        <Border x:Name="PerformanceHit" Background="Transparent" MouseLeftButtonUp="PerformanceHit_MouseUp" Cursor="Hand">
                            <Grid Height="22">
                                <TextBlock Text="Performance" Style="{StaticResource SubItemLabel}"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock x:Name="PerformanceValue" Text="High (60 FPS)" Style="{StaticResource SectionValue}"/>
                                    <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               Margin="6,1,0,0" Foreground="#99FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="FullscreenHit" Background="Transparent" MouseLeftButtonUp="FullscreenHit_MouseUp" Cursor="Hand">
                            <Grid Height="22">
                                <TextBlock Text="In fullscreen games" Style="{StaticResource SubItemLabel}"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock x:Name="FullscreenValue" Text="Hide all" Style="{StaticResource SectionValue}"/>
                                    <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               Margin="6,1,0,0" Foreground="#99FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Frost on edges" Style="{StaticResource SubItemLabel}" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" x:Name="FrostToggle" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Haze" Style="{StaticResource SubItemLabel}" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" x:Name="MistToggle" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Melt snow" Style="{StaticResource SubItemLabel}" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" x:Name="MeltToggle" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"/>
                        </Grid>

                        <Border x:Name="MeltAfterHit" Background="Transparent" Margin="12,1,0,0"
                                MouseLeftButtonUp="MeltAfterHit_MouseUp" Cursor="Hand">
                            <Grid Height="22">
                                <TextBlock Text="Melt after" Style="{StaticResource SubItemLabel}"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock x:Name="MeltAfterValue" Text="Off" Style="{StaticResource SectionValue}"/>
                                    <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               Margin="6,1,0,0" Foreground="#99FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock Text="COLOR" Style="{StaticResource GroupHeader}"/>
                <Border Style="{StaticResource PopPanel}" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="10,6" Margin="0,0,0,7">
                    <StackPanel>
                        <Grid Margin="0,0,0,3">
                            <TextBlock Text="Snow hue" Style="{StaticResource SectionLabel}"/>
                            <TextBlock x:Name="SnowHueValue" Text="210°" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"
                                       FontSize="11.5" FontWeight="SemiBold"/>
                        </Grid>
                        <Slider x:Name="SnowHueSlider" Style="{StaticResource MenuSlider}"
                                Minimum="0" Maximum="360" SmallChange="5" LargeChange="30" Margin="0,0,0,6"/>

                        <Grid Margin="0,0,0,3">
                            <TextBlock Text="Snow tint" Style="{StaticResource SectionLabel}"/>
                            <TextBlock x:Name="SnowSatValue" Text="45%" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"
                                       FontSize="11.5" FontWeight="SemiBold"/>
                        </Grid>
                        <Slider x:Name="SnowSatSlider" Style="{StaticResource MenuSlider}"
                                Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.2" Margin="0,0,0,6"/>

                        <Grid Margin="0,1,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Separate rain color" Style="{StaticResource SubItemLabel}" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" x:Name="SeparateRainToggle" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel x:Name="RainColorBlock" Visibility="Collapsed">
                            <Grid Margin="0,0,0,3">
                                <TextBlock Text="Rain hue" Style="{StaticResource SectionLabel}"/>
                                <TextBlock x:Name="RainHueValue" Text="215°" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"
                                           FontSize="11.5" FontWeight="SemiBold"/>
                            </Grid>
                            <Slider x:Name="RainHueSlider" Style="{StaticResource MenuSlider}"
                                    Minimum="0" Maximum="360" SmallChange="5" LargeChange="30" Margin="0,0,0,6"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,3">
                            <TextBlock Text="Haze hue" Style="{StaticResource SectionLabel}"/>
                            <TextBlock x:Name="MistHueValue" Text="210°" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"
                                       FontSize="11.5" FontWeight="SemiBold"/>
                        </Grid>
                        <Slider x:Name="MistHueSlider" Style="{StaticResource MenuSlider}"
                                Minimum="0" Maximum="360" SmallChange="5" LargeChange="30" Margin="0,0,0,4"/>

                        <Button x:Name="ResetColorButton" Style="{StaticResource MenuButton}"
                                Content="Reset color" Margin="0,2,0,0" Click="ResetColorButton_Click"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="SYSTEM" Style="{StaticResource GroupHeader}"/>
                <Border Style="{StaticResource PopPanel}" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="10,6" Margin="0,0,0,7">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Start with Windows" Style="{StaticResource SubItemLabel}" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" x:Name="AutoStartToggle" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="UPDATES" Style="{StaticResource GroupHeader}"/>
                <Border Style="{StaticResource PopPanel}" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="10,6" Margin="0,0,0,7">
                    <StackPanel>
                        <Grid Margin="0,0,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Beta channel" Style="{StaticResource SubItemLabel}" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" x:Name="BetaToggle" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"/>
                        </Grid>

                        <Border x:Name="CheckUpdateHit" Background="Transparent" MouseLeftButtonUp="CheckUpdateHit_MouseUp" Cursor="Hand">
                            <Grid Height="22">
                                <TextBlock Text="Check for updates" Style="{StaticResource SubItemLabel}"/>
                                <TextBlock x:Name="UpdateStatusValue" Text="Idle" Style="{StaticResource SectionValue}"/>
                            </Grid>
                        </Border>

                        <Border x:Name="UpdateCard" Visibility="Collapsed" Style="{StaticResource PopPanel}"
                                Background="#14FFFFFF" CornerRadius="6" Padding="8" Margin="0,5,0,0">
                            <StackPanel>
                                <TextBlock x:Name="UpdateVersionText" Foreground="#F2FFFFFF" FontSize="12.5" FontWeight="SemiBold"/>
                                <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto" Margin="0,4,0,6">
                                    <TextBlock x:Name="UpdateNotesText" Foreground="#99FFFFFF" FontSize="11.5" TextWrapping="Wrap"/>
                                </ScrollViewer>
                                <ProgressBar x:Name="UpdateProgress" Height="4" Minimum="0" Maximum="1"
                                             Background="#33FFFFFF" BorderThickness="0"
                                             Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"
                                             Margin="0,0,0,6"/>
                                <Button x:Name="UpdateNowButton" Style="{StaticResource MenuButton}"
                                        Content="Update &amp; restart" Margin="0,0,0,2"/>
                                <Button x:Name="DeferButton" Style="{StaticResource MenuButton}"
                                        Content="Install on shutdown"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Button x:Name="ClearButton" Style="{StaticResource MenuButton}" Content="Clear snow" Margin="0,0,0,2"/>
                <Button x:Name="QuitButton" Style="{StaticResource MenuButton}" Content="Quit"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>